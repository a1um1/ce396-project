Table users [headercolor: #6360f7] {
	id uuid [ pk, not null, default: `UUIDV7()` ]
	name varchar(100) [ not null ]
	email varchar(150) [ not null, unique ]
	password_hash varchar(255) [ not null ]
	profile_image varchar(255) [ not null ]
	created_at timestamptz [ not null ]
	update_at timestamptz [ not null ]
}

Table Phon_user [headercolor: #175e7a] {
	id uuid [ pk, not null, default: `UUIDV7()` ]
	user_id uuid [ not null ]
	phone_number varchar(20) [ not null, unique ]
}

Table Rider [headercolor: #36e094] {
	id uuid [ pk, not null, default: `UUIDV7()` ]
	user_id uuid [ not null ]
	id_card_number varchar(20) [ not null ]
	status varchar(20) [ not null ]
	total_rides int [ not null ]
	created_at timestamptz [ not null ]
}

Table RideRequest [headercolor: #42c96d] {
	id uuid [ pk, not null, default: `UUIDV7()` ]
	user_id uuid [ not null ]
	vehicle_type_id uuid [ not null ]
	pickup_lat numeric(9,6) [ not null ]
	pickup_lng numeric(9,6) [ not null ]
	pickup_address varchar(255) [ not null ]
	dropoff_lat numeric(9,6) [ not null ]
	dropoff_lng numeric(9,6) [ not null ]
	dropoff_address varchar(255) [ not null ]
	status varchar(20) [ not null ]
	requested_at timestamptz [ not null ]
}

Table RideHistory [headercolor: #0b8c52] {
	id uuid [ pk, not null, default: `UUIDV7()` ]
	ride_request_id uuid [ not null ]
	user_id uuid [ not null ]
	rider_id uuid [ not null ]
	vehicle_id uuid [ not null ]
	distance_km numeric(6,2) [ not null ]
	duration_min int [ not null ]
	base_price numeric(10,2) [ not null ]
	final_price numeric(10,2) [ not null ]
	start_time timestamptz [ not null ]
	end_time timestamptz [ not null ]
	status varchar(20) [ not null ]
}

Table Review [headercolor: #07b5fa] {
	id uuid [ pk, not null, default: `UUIDV7()` ]
	ride_history_id uuid [ not null, unique ]
	rating int [ not null ]
	comment text [ not null ]
	created_at timestamptz [ not null ]
}

Table "Payment History" [headercolor: #d60d0d] {
	id uuid [ pk, not null ]
	ride_history_id uuid [ not null ]
	payment_method_id uuid [ not null ]
	amount numeric(10,2) [ not null ]
	status varchar(20) [ not null ]
	paid_at timestamptz [ not null ]
}

Table "Payment Methods" [headercolor: #ff0a5c] {
	id uuid [ pk, not null, default: `UUIDV7()` ]
	user_id uuid [ not null ]
	type varchar(20) [ not null ]
	provider varchar(50) [ not null ]
	account_nimber varchar(30) [ not null ]
	is_default boolean [ not null ]
}

Table "Discount History" [headercolor: #cf11fa] {
	id uuid [ pk, not null, default: `UUIDV7()` ]
	payment_history_id uuid [ not null ]
	discount_id uuid [ not null ]
	discount_amount numeric(10,2) [ not null ]
	applied_at timestamptz [ not null ]
}

Table Discount [headercolor: #ee81fc] {
	id uuid [ pk, not null, default: `UUIDV7()` ]
	code varchar(30) [ not null, unique ]
	description varchar(255) [ not null ]
	discount_type varchar(10) [ not null ]
	value numeric(10,2) [ not null ]
	valid_from timestamptz [ not null ]
	valid_to timestamptz [ not null ]
}

Table Vehicles [headercolor: #fce028] {
	id uuid [ pk, not null, default: `UUIDV7()` ]
	rider_id uuid [ not null ]
	vehicle_type_id uuid [ not null ]
	license_plate varchar(15) [ not null, unique ]
	brand varchar(50) [ not null ]
	model varchar(50) [ not null ]
	color varchar(30) [ not null ]
	year int [ not null ]
	status varchar(20) [ not null ]
}

Table GovermentDocuments [headercolor: #ff6e3d] {
	id uuid [ pk, not null, default: `UUIDV7()` ]
	rider_id uuid [ not null ]
	document_type varchar(3) [ not null ]
	document_number varchar(30) [ not null ]
	file_url varchar(255) [ not null ]
	verification_status varchar(20) [ not null ]
	verified_at timestamptz [ not null ]
	expiry_date date [ not null ]
}

Table VechiclesTypes [headercolor: #d6c315] {
	id uuid [ pk, not null, default: `UUIDV7()` ]
	name varchar(50) [ not null ]
	description varchar(255) [ not null ]
	base_fare numeric(10,2) [ not null ]
	price_per_km numeric(10,2) [ not null ]
	capacity int [ not null ]
}

Table DistanceToPrice [headercolor: #175e7a] {
	id uuid [ pk, not null, default: `UUIDV7()` ]
	min_distance_km numeric(6,2) [ not null ]
	max_distance_km numeric(6,2) [ not null ]
	price_per_km numeric(10,2) [ not null ]
}

Table TimePriceMultiplier [headercolor: #175e7a] {
	id uuid [ pk, not null, default: `UUIDV7()` ]
	name varchar(50) [ not null ]
	start_time time [ not null ]
	end_time time [ not null ]
	multiplier numeric(4,2) [ not null ]
}

Table "Audit Log" [headercolor: #175e7a] {
	id uuid [ pk, not null, default: `UUIDV7()` ]
	table_name varchar(50) [ not null ]
	record_id uuid [ not null ]
	old_value text [ not null ]
	new_value text [ not null ]
	created_at timestamptz [ not null ]
}

Ref "fk_Rider_user_id _users" {
	Rider.user_id > users.id [ delete: no action, update: no action ]
}

Ref fk_GovermentDocuments_rider_id_Rider {
	GovermentDocuments.rider_id > Rider.id [ delete: no action, update: no action ]
}

Ref fk_Vehicles_rider_id_Rider {
	Vehicles.rider_id > Rider.id [ delete: no action, update: no action ]
}

Ref fk_Vehicles_vehicle_type_id_VechiclesTypes {
	Vehicles.vehicle_type_id > VechiclesTypes.id [ delete: no action, update: no action ]
}

Ref "fk_RideRequest_user_id _users" {
	RideRequest.user_id > users.id [ delete: no action, update: no action ]
}

Ref fk_RideHistory_ride_request_id_RideRequest {
	RideHistory.ride_request_id > RideRequest.id [ delete: no action, update: no action ]
}

Ref fk_RideHistory_user_id_users {
	RideHistory.user_id > users.id [ delete: no action, update: no action ]
}

Ref fk_RideHistory_rider_id_Rider {
	RideHistory.rider_id > Rider.id [ delete: no action, update: no action ]
}

Ref fk_RideHistory_vehicle_id_Vehicles {
	RideHistory.vehicle_id > Vehicles.id [ delete: no action, update: no action ]
}

Ref "fk_users_id_Payment Methods" {
	users.id < "Payment Methods".user_id [ delete: no action, update: no action ]
}

Ref "fk_Payment History_ride_history_id_RideHistory" {
	"Payment History".ride_history_id > RideHistory.id [ delete: no action, update: no action ]
}

Ref "fk_Payment History_payment_method_id_Payment Methods" {
	"Payment History".payment_method_id > "Payment Methods".id [ delete: no action, update: no action ]
}

Ref "fk_Review_ride_history_id_Payment History" {
	Review.ride_history_id > "Payment History".id [ delete: no action, update: no action ]
}

Ref "fk_Discount History_payment_history_id_Payment History" {
	"Discount History".payment_history_id > "Payment History".id [ delete: no action, update: no action ]
}

Ref "fk_Discount History_discount_id_Discount" {
	"Discount History".discount_id > Discount.id [ delete: no action, update: no action ]
}

Ref fk_Phon_user_user_id_users {
	Phon_user.user_id > users.id [ delete: no action, update: no action ]
}